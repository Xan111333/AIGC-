# 数据库配置
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=aigc_platform
MYSQL_USER=aigc_user
MYSQL_PASSWORD=your_strong_db_password

# 安全配置
SECRET_KEY=your_very_long_secret_key_at_least_32_characters

# 域名配置
PRODUCTION_DOMAIN=yourdomain.com

# MinIO配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password

# API Key配置（可选，不配置使用Mock数据）
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY
QIANFAN_AK=YOUR_QIANFAN_AK
QIANFAN_SK=YOUR_QIANFAN_SK

# 环境
ENVIRONMENT=production
