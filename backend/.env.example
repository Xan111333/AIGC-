# 数据库配置
DATABASE_URL=mysql+mysqlconnector://username:password@localhost:3306/aigc_training

# JWT配置
SECRET_KEY=your-secret-key-here-keep-it-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 本地文件存储配置
STORAGE_ROOT=storage
STORAGE_URL_PREFIX=/api/files

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# DeepSeek API配置 (文本生成)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# 百度千帆 API配置 (图像生成和语音合成)
QIANFAN_AK=your-qianfan-access-key-here
QIANFAN_SK=your-qianfan-secret-key-here
QIANFAN_IMAGE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/image/generate
QIANFAN_TTS_URL=https://tsn.baidu.com/text2audio